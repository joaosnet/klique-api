# Credenciais do Gmail
GMAIL_EMAIL="seu_email@gmail.com"
GMAIL_APP_PASSWORD="sua_senha_de_app"

# Credenciais da API do Google
GOOGLE_API_KEY="sua_google_api_key"
SECRET_KEY="sua_secret_key_aqui"

# Cookies para a Gemini Web API (obrigatórios para o Docker)
# Obtenha os valores no seu navegador em https://gemini.google.com
SECURE_1PSID="seu_cookie_secure_1psid"
SECURE_1PSIDTS="seu_cookie_secure_1psidts"