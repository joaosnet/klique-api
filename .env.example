# Copie este arquivo para `.env` e preencha com seus valores locais.
# NÃO comite o arquivo `.env` com segredos reais.

# Timezone
TZ=America/Sao_Paulo

# Segurança
SECRET_KEY=changeme

# Google
GOOGLE_API_KEY=changeme
GOOGLE_APPLICATION_CREDENTIALS=creds.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=changeme

# Banco de dados (utilizados pelo serviço fastapi e pela imagem mongo)
DB_CONNECTION=mongodb
DB_HOST=mongodb_kliqueq
DB_PORT=27017
DB_DATABASE=klique
DB_USERNAME=root
DB_PASSWORD=password

# Variáveis do MongoDB (inicialização)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=klique

# Gmail
GMAIL_EMAIL=seu@email.com
GMAIL_APP_PASSWORD=senha_de_app

# Gemini (cookies usados pelo gemini provider, se aplicável)
SECURE_1PSID=seu_cookie_secure_1psid
SECURE_1PSIDTS=seu_cookie_secure_1psidts

# APIs externas
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_BASE=
PUTER_API_KEY=

# Mercado Pago (Pagamentos PIX)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=TEST-xxx-xxx-xxx
MP_PUBLIC_KEY=TEST-xxx-xxx
MP_WEBHOOK_SECRET=sua_secret_webhook

# Preços
MIN_PAYMENT_AMOUNT=1.0
CREDITS_PER_REAL=1
FREE_CREDITS_PER_USER=1

# Traefik
DOMAIN=seudominio.com
ACME_EMAIL=seuemail@exemplo.com