# Google OAuth Client ID (from Google Cloud Console)
# Create at: https://console.cloud.google.com/apis/credentials
# Type: Web Application
# Authorized JavaScript origins: http://localhost:5173, https://omniflash.app, capacitor://localhost
VITE_GOOGLE_CLIENT_ID=

# Apple Sign In (requires Apple Developer Account - $99/year)
# Create Service ID at: https://developer.apple.com/account/resources/identifiers
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://omniflash.app

# Backend API URL (leave empty for same-origin in production)
VITE_API_URL=http://localhost:8000
