FROM cgr.dev/chainguard/node:latest-dev

USER root
RUN mkdir -p /app

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --include=dev

# Expose Vite dev server port
EXPOSE 3000

# Start Vite dev server with hot-reload
ENTRYPOINT ["npm"]
CMD ["run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
